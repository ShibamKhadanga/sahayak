# Virtual Environments
.env
.venv
venv/
env/
ENV/

# =========================
# ML Models (large files)
# =========================
backend/models/*.pkl
backend/models/*.joblib
backend/models/*.h5
backend/models/*.pt
backend/models/*.onnx
